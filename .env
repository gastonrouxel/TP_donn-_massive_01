# 8INF919 - TP1 : parametres a calibrer du generateur (README, section 5).
# Durees et taux en temps simule. Apres une modification, relancer :
#   docker compose up --build
# ou, si le generateur est detache : docker compose up -d generateur

# Debit, en evenements par seconde : 120 = temps reel, 1200 = x10, 12000 = x100
GEN_DEBIT=1200
# Vide : flux different a chaque lancement ; un entier : tirages reproductibles
GEN_SEED=

# Dynamique du procede
GEN_DUREE_REGIME_S=180
GEN_USURE_PAR_HEURE=0.10
GEN_TAUX_PANNE_PAR_HEURE=1.0

# Defauts de donnees (0 desactive)
GEN_P_PERTE=0.002
GEN_P_DOUBLON=0.002
GEN_P_RETARD=0.003
GEN_P_ABERRANT=0.001
GEN_P_CHAMP_ABSENT=0.001
GEN_TAUX_GEL_PAR_HEURE=2.0
GEN_TAUX_FIRMWARE_PAR_HEURE=0.2
